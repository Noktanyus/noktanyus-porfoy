/**
 * @file Vercel Environment Variables Template
 * @description Production ortamında gerekli tüm env variable'lar.
 *              `vercel env add <KEY> production` ile eklenir.
 *
 *              Gerekli (Required):
 *              - DATABASE_URL: PostgreSQL connection string
 *              - NEXTAUTH_SECRET: 32+ karakter random string
 *              - NEXTAUTH_URL: Production URL (https://yourdomain.com)
 *              - NEXT_PUBLIC_BASE_URL: Production URL (public)
 *
 *              Ödeme (Payment) — Türkiye birincil: PayTR iFrame API:
 *              - PAYTR_MERCHANT_ID / PAYTR_MERCHANT_KEY / PAYTR_MERCHANT_SALT
 *              - PAYTR_TEST_MODE=0 (canlı), PAYTR_DEBUG_ON, PAYTR_CHECKOUT_MODE=iframe
 *              - Bildirim URL: https://noktanyus.com/api/webhooks/paytr
 *              Legacy (opsiyonel): STRIPE_*, IYZICO_*
 *
 *              Email:
 *              - RESEND_API_KEY: Resend email service (production)
 *              - EMAIL_FROM: noreply@yourdomain.com
 *
 *              Storage:
 *              - BLOB_READ_WRITE_TOKEN: Vercel Blob token (upload için)
 *              - veya AWS_* değişkenleri (S3)
 *
 *              Monitoring:
 *              - SENTRY_DSN: Sentry project DSN
 *              - SENTRY_ORG: Sentry organization slug
 *              - SENTRY_PROJECT: Sentry project slug
 *              - SENTRY_AUTH_TOKEN: Sentry auth token (source map upload)
 *
 *              Analytics:
 *              - NEXT_PUBLIC_YANDEX_METRICA_ID: Yandex Metrica counter ID
 *
 *              Optional:
 *              - SANDBOX_MODE: true/false (sandbox ortamı için)
 *              - ANALYZE: true (bundle analyzer için, build-time)
 *              - CLOUDflare_TUNNEL_TOKEN: Cloudflare tunnel (production)
 */

# === DATABASE ===
DATABASE_URL="postgres://user:pass@host:5432/db?schema=public"
DIRECT_URL="postgres://user:pass@host:5432/db?schema=public"

# === AUTH ===
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://yourdomain.com"
NEXT_PUBLIC_BASE_URL="https://yourdomain.com"

# === PAYMENT (PayTR iFrame API — birincil, TR) ===
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
# 1 = test/sandbox, 0 = canlı (gerçek tahsilat)
PAYTR_TEST_MODE="0"
# 1 = hata mesajlarını göster (entegrasyon sonrası canlıda 0 önerilir)
PAYTR_DEBUG_ON="1"
# iframe (önerilen) | direct (kart formu sitede)
PAYTR_CHECKOUT_MODE="iframe"
# Havale/EFT için PayTR mağaza yetkisi gerekir
PAYTR_EFT_ENABLED="0"
# Taksit: 1 = gösterme, max: 0 = PayTR varsayılanı
PAYTR_NO_INSTALLMENT="0"
PAYTR_MAX_INSTALLMENT="0"
PAYTR_TIMEOUT_LIMIT="30"
# Yalnızca Direkt API: 0 = 3D Secure (önerilen)
PAYTR_NON_3D="0"
# Bildirim URL (PayTR panel): https://noktanyus.com/api/webhooks/paytr

# Legacy (PayTR yoksa fallback)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
IYZICO_API_KEY="sandbox-..."
IYZICO_SECRET_KEY="sandbox-..."
IYZICO_BASE_URL="https://api.iyzipay.com"

# Cal.com / Calendly embed URL (randevu sayfası)
NEXT_PUBLIC_BOOKING_URL=""

# === TEMPLATE MARKETPLACE (Phase 3 B.4) ===
# Gumroad webhook + checkout. Tek secret yeterli; product map opsiyonel
# (yoksa webhook payload'indaki product_permalink slug olarak kullanilir).
# GUMROAD_WEBHOOK_SECRET — Gumroad → Settings → Advanced → Ping webhook secret
# GUMROAD_PRODUCT_MAP   — JSON: { "<gumroad_product_id>": "<template_slug>" }
# GUMROAD_API_KEY       — Opsiyonel: fetchGumroadSale (advanced verify) icin
GUMROAD_WEBHOOK_SECRET=""
GUMROAD_PRODUCT_MAP='{"abc123":"ecommerce-starter","def456":"saas-landing"}'
GUMROAD_API_KEY=""

# Lemon Squeezy webhook + checkout. Hem secret hem API key + store id gerekli.
# LEMONSQUEEZY_WEBHOOK_SECRET — Lemon Squeezy → Settings → Webhooks → Signing secret
# LEMONSQUEEZY_PRODUCT_MAP   — JSON: { "<ls_variant_id>": "<template_slug>" }
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_PRODUCT_MAP='{"100001":"ecommerce-starter","100002":"saas-landing"}'

# === EMAIL ===
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.com"

# === STORAGE ===
BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# === MONITORING ===
SENTRY_DSN="https://...@sentry.io/..."
SENTRY_ORG="your-org"
SENTRY_PROJECT="noktanyus-prod"
SENTRY_AUTH_TOKEN="sntrys_..."

# === ANALYTICS ===
NEXT_PUBLIC_YANDEX_METRICA_ID="12345678"

# === OPTIONAL ===
SANDBOX_MODE="false"
ANALYZE="false"

# === AI Provider (OpenAI-compatible) ===
# Bugün MiniMax, yarın başka bir model — sadece 3 env değiştir.
# OpenAI uyumlu tüm provider'lar çalışır: MiniMax, OpenAI, OpenRouter, Mistral, Groq, vb.
# 3 env'nin 3'ü de dolu olmalı (mock mode için hepsini boş bırak).
AI_BASE_URL=""            # Örn: https://api.minimaxi.com/v1
AI_API_KEY=""             # Provider API key
AI_MODEL=""               # Örn: MiniMax-M3, gpt-4o, anthropic/claude-3.5-sonnet
AI_PROVIDER_DISPLAY_NAME="" # Opsiyonel: UI badge (default: AI_MODEL değeri)

# === Redis (opsiyonel; rate-limit dağıtım modu için) ===
# REDIS_URL tanımlıysa rate limiter Redis (distributed) modunda çalışır;
# tanımlı değilse in-memory fallback kullanır (tek instance için yeterli,
# çok-instance dağıtımda Redis zorunlu).
REDIS_URL=""

# === Subdomain Routing (Phase 3 B.6) ===
# Prod-only: SUBDOMAIN_ROUTING_ENABLED=true ile aktif. Reverse proxy
# (Cloudflare Worker veya Vercel middleware) Host header'ı okuyup
# /workspace/{slug} rewrite yapar.
SUBDOMAIN_ROUTING_ENABLED="false"

# === SAML SSO (opsiyonel) ===
# Identity Provider metadata otomatik çekilir; alternatif olarak direkt
# SAML_IDP_CERT + SAML_IDP_SSO_URL + SAML_IDP_ENTITY_ID env'leri verilebilir.
SAML_SP_ENTITY_ID=""
SAML_SP_ACS_URL=""
SAML_IDP_METADATA_URL=""
SAML_IDP_CERT=""
SAML_IDP_SSO_URL=""
SAML_IDP_ENTITY_ID=""

# === Cron Security ===
# Vercel Cron Jobs tarafından çağrılan endpoint'lerin güvenliği için.
# X-Cron-Secret header kontrolü için kullanılır.
CRON_SECRET=""

# === Web Push (VAPID — opsiyonel) ===
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@noktanyus.com"