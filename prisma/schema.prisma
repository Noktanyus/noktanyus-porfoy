generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model About {
  id              String       @id @default(cuid())
  name            String
  title           String
  subTitle        String?
  headerTitle     String
  profileImage    String?
  aboutImage      String?
  content         String
  contactEmail    String?
  socialGithub    String?
  socialLinkedin  String?
  socialInstagram String?
  workingOn       String       @default("")
  experiences     Experience[]
  skills          Skill[]
}

model Experience {
  id          String  @id @default(cuid())
  title       String
  company     String
  date        String
  description String
  aboutId     String?
  about       About?  @relation(fields: [aboutId], references: [id])
}

model Skill {
  id      String  @id @default(cuid())
  name    String
  icon    String?
  aboutId String?
  About   About?  @relation(fields: [aboutId], references: [id])
}

model Testimonial {
  id      String  @id @default(cuid())
  name    String
  title   String
  company String
  avatar  String?
  comment String
}

model Blog {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  date        DateTime @default(now())
  description String
  thumbnail   String?
  author      String
  category    String
  tags        Json     @default("[]")
  content     String

  // Analytics alanlari (Phase 6 blog analytics kapsaminda eklendi).
  viewCount       Int @default(0)
  readTimeMinutes Int @default(1)
  likeCount       Int @default(0)

  // Scheduling & Drafts (Phase Blog Scheduling kapsaminda eklendi).
  status           String    @default("published") // draft | scheduled | published
  publishedAt      DateTime?
  scheduledAt      DateTime?
  draftSavedAt     DateTime?
  version          Int       @default(1)
  parentVersionId  String?

  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([viewCount])
  @@index([status, scheduledAt])
}

model Project {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  description  String
  mainImage    String?
  technologies Json      @default("[]")
  liveDemo     String?
  githubRepo   String?
  order        Int       @default(0)
  featured     Boolean   @default(false)
  isLive       Boolean   @default(false)
  content      String
  date         DateTime?
}

model Popup {
  id              String  @id @default(cuid())
  slug            String  @unique
  title           String
  content         String
  imageUrl        String?
  youtubeEmbedUrl String?
  isActive        Boolean @default(true)
  buttons         Json    @default("[]")
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  timestamp DateTime @default(now())
  isRead    Boolean  @default(false)
  replies   Json     @default("[]")
}

model HomeSettings {
  id                  String  @id @default(cuid())
  featuredContentType String
  youtubeUrl          String?
  textTitle           String?
  textContent         String?
  customHtml          String?
}

model SeoSettings {
  id                 String  @id @default(cuid())
  siteTitle          String
  siteDescription    String
  siteKeywords       String  @default("")
  canonicalUrl       String
  robots             String
  favicon            String?
  ogTitle            String?
  ogDescription      String?
  ogImage            String?
  ogType             String?
  ogUrl              String?
  ogSiteName         String?
  twitterCard        String?
  twitterSite        String?
  twitterCreator     String?
  twitterTitle       String?
  twitterDescription String?
  twitterImage       String?
}

/// Admin Audit Log
/// Admin panelinden yapılan tüm kritik işlemleri kayıt altına alır.
/// Phase 2E kapsamında eklendi.
model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  userEmail    String?
  action       String
  resource     String
  resourceId   String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  status       String   @default("success")
  errorMessage String?
  timestamp    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([timestamp])
  @@map("audit_logs")
}

// =================== COMMERCE / SAAS ===================

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  FULFILLED
  CANCELED
}

enum PlanInterval {
  MONTH
  YEAR
  WEEK
  DAY
}

enum LicenseType {
  PERPETUAL
  SUBSCRIPTION
  TRIAL
  ONE_TIME
}

model Plan {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            String
  description     String?
  stripePriceId   String       @unique
  stripeProductId String
  interval        PlanInterval @default(MONTH)
  priceCents      Int
  currency        String       @default("try")
  features        Json         @default("[]")
  active          Boolean      @default(true)
  isFeatured      Boolean      @default(false)
  order           Int          @default(0)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model Customer {
  id               String  @id @default(cuid())
  userId           String? @unique
  user             User?   @relation(fields: [userId], references: [id])
  email            String  @unique
  name             String?
  stripeCustomerId String? @unique
  phone            String?
  billingAddress   Json?

  subscriptions Subscription[]
  orders        Order[]
  licenses      License[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id])

  stripeSubscriptionId String             @unique
  stripeStatus         String
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?

  trialStart DateTime?
  trialEnd   DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model DigitalProduct {
  id               String  @id @default(cuid())
  slug             String  @unique
  title            String
  shortDescription String
  description      String
  thumbnail        String?
  images           Json    @default("[]")
  fileUrl          String
  fileName         String
  fileSize         Int
  priceCents       Int
  currency         String  @default("try")

  // Delivery
  downloadCountMax Int @default(5)
  ttlHours         Int @default(72)

  // Metadata
  technologies Json    @default("[]")
  category     String  @default("general")
  version      String?
  requirements Json?

  active   Boolean @default(true)
  featured Boolean @default(false)
  order    Int     @default(0)

  // Owner (SaaS)
  ownerId String?
  owner   User?   @relation("ProductOwner", fields: [ownerId], references: [id])

  orderItems OrderItem[]
  licenses   License[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
  @@index([category])
  @@index([ownerId])
}

model Order {
  id          String    @id @default(cuid())
  orderNumber String    @unique
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])

  // SaaS user link
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Stripe
  stripeSessionId     String  @unique
  stripePaymentIntent String? @unique

  status OrderStatus @default(PENDING)

  // Money
  subtotalCents Int
  taxCents      Int    @default(0)
  totalCents    Int
  currency      String @default("try")

  // Customer info snapshot
  customerEmail String
  customerName  String?

  // Fulfillment
  deliveredAt  DateTime?
  refundedAt   DateTime?
  refundReason String?

  // Coupon / Discount
  couponId      String?
  coupon        Coupon? @relation(fields: [couponId], references: [id])
  discountCents Int     @default(0)

  metadata Json?
  notes    String?

  items    OrderItem[]
  licenses License[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([couponId])
  @@index([userId])
}

model Coupon {
  id                 String       @id @default(cuid())
  code               String       @unique
  description        String?
  discountType       DiscountType @default(PERCENTAGE)
  discountValue      Int
  minOrderCents      Int          @default(0)
  maxDiscountCents   Int?
  maxUses            Int?
  currentUses        Int          @default(0)
  maxUsesPerUser     Int          @default(1)
  startsAt           DateTime?
  expiresAt          DateTime?
  applicableProducts Json?
  applicablePlans    Json?
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]

  @@index([code, active])
  @@index([active])
  @@index([expiresAt])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id])
  orderId       String?
  customerEmail String
  discountCents Int
  redeemedAt    DateTime @default(now())

  @@index([couponId])
  @@index([customerEmail])
  @@index([couponId, customerEmail])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   DigitalProduct @relation(fields: [productId], references: [id])

  quantity       Int @default(1)
  unitPriceCents Int
  totalCents     Int

  // Snapshot
  productTitle String
  productSlug  String

  createdAt DateTime @default(now())

  @@index([orderId])
}

model License {
  id         String         @id @default(cuid())
  key        String         @unique
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id])
  productId  String
  product    DigitalProduct @relation(fields: [productId], references: [id])
  orderId    String?
  order      Order?         @relation(fields: [orderId], references: [id])

  // SaaS user link
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  type               LicenseType @default(ONE_TIME)
  status             String      @default("active")
  maxActivations     Int         @default(1)
  currentActivations Int         @default(0)

  expiresAt    DateTime?
  revokedAt    DateTime?
  revokeReason String?

  activations Json  @default("[]")
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([productId])
  @@index([status])
  @@index([userId])
}

model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
  payload       Json
  success       Boolean  @default(true)
  error         String?

  @@index([type])
  @@index([processedAt])
}

// =================== TEAM / WORKSPACE / RBAC ===================
// Phase 3 kapsamında eklendi. Multi-tenant workspace sistemi + rol bazlı erişim kontrolü.

model Workspace {
  id          String                @id @default(cuid())
  slug        String                @unique
  name        String
  description String?
  ownerId     String
  owner       User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([ownerId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User?         @relation(fields: [userId], references: [id])
  userEmail   String
  userName    String?
  role        WorkspaceRole @default(VIEWER)
  joinedAt    DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model WorkspaceInvitation {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        WorkspaceRole    @default(VIEWER)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedBy   String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@index([workspaceId])
  @@index([email, status])
}

// =================== USER / AUTH (NextAuth) ===================
// Phase 4 kapsamında eklendi. Centralized user account for SaaS features.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String? // bcrypt hash, NextAuth credential provider
  image         String?
  emailVerified DateTime?

  // 2FA (TOTP) alanlari - Phase 5 auth genisletme kapsaminda eklendi.
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes Json?
  twoFactorVerifiedAt  DateTime?

  // Profile + Referral alanlari (Phase Chat + Coupon Advanced kapsaminda eklendi).
  birthDate      DateTime?
  referralCode   String?   @unique
  referredBy     String?
  referralCount  Int        @default(0)

  // Relations
  accounts             Account[]
  sessions             Session[]
  apiKeys              ApiKey[]
  monitors             Monitor[]
  alertChannels        AlertChannel[]
  subscriptions        UserSubscription[]
  statusPages          StatusPage[]
  customerProfile      Customer?
  orders               Order[]
  uploadedProducts     DigitalProduct[]   @relation("ProductOwner")
  bundles              Bundle[]           @relation("BundleOwner")
  licenses             License[]
  workspaceMemberships WorkspaceMember[]
  ownedWorkspaces      Workspace[]        @relation("WorkspaceOwner")
  auditLogs            AuditLog[]
  comments             Comment[]
  webhooks             Webhook[]
  notifications        Notification[]
  conversations        ChatConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([referralCode])
}

/// Chat Conversation
/// In-app canli destek sistemi. Kullanici <-> Admin mesajlasma akisi.
/// Phase Chat + Coupon Advanced kapsaminda eklendi.
model ChatConversation {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject      String
  status       String   @default("open") // open | waiting | closed

  assignedTo   String? // admin user id

  lastMessageAt  DateTime?
  unreadByUser   Int       @default(0)
  unreadByAdmin  Int       @default(0)

  messages ChatMessage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@index([userId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([assignedTo, status])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId   String
  senderRole String // "user" | "admin"
  senderName String

  content     String @db.Text
  attachments Json   @default("[]")

  read   Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

// =================== DIGITAL PRODUCT BUNDLES ===================
// Phase "Subscription + Bundles" kapsaminda eklendi.
// Birden fazla dijital urunu paketleyip indirimli satma imkani saglar.

model Bundle {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  description      String
  shortDescription String
  thumbnail        String?

  // Pricing
  priceCents         Int // Bundle discounted price
  originalPriceCents Int // Sum of individual product prices
  currency           String @default("try")

  // Products (JSON array of product ids)
  productIds Json @default("[]")

  // Metadata
  features Json    @default("[]")
  category String  @default("bundle")
  version  String?

  // Status
  active   Boolean @default(true)
  featured Boolean @default(false)
  order    Int     @default(0)

  // Sales counter
  totalSales Int @default(0)

  // Owner (SaaS)
  ownerId String?
  owner   User?   @relation("BundleOwner", fields: [ownerId], references: [id])

  purchases BundlePurchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
  @@index([ownerId])
}

model BundlePurchase {
  id     String @id @default(cuid())
  bundleId String
  bundle   Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  buyerEmail String
  buyerId    String?

  priceCents Int
  currency   String

  status String @default("completed") // completed | refunded

  createdAt DateTime @default(now())

  @@index([bundleId])
  @@index([buyerId])
}

// NextAuth OAuth (opsiyonel - ileride Google/GitHub login için)
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

// =================== API KEYS / RATE LIMITING ===================
// Phase 4 kapsamında eklendi. Public API için API key yönetimi + rate limit.

model ApiKey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String // "Production Server", "Mobile App" vb.
  key    String @unique // nokt_live_xxxxx veya nokt_test_xxxxx
  prefix String // İlk 8 karakter (UI'da gösterim için)
  scopes Json   @default("[]") // ["read:monitor", "write:monitor", "admin"]

  // Limits
  rateLimit    Int  @default(60) // requests per minute
  monthlyQuota Int? // null = unlimited

  // Tracking
  lastUsedAt    DateTime?
  totalRequests Int       @default(0)

  // Lifecycle
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages ApiKeyUsage[]

  @@index([userId])
  @@index([key])
}

model ApiKeyUsage {
  id       String @id @default(cuid())
  apiKeyId String
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  endpoint   String // "/api/monitor/check"
  method     String // "GET", "POST"
  statusCode Int // 200, 401, 429
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([apiKeyId, timestamp])
  @@index([endpoint])
}

// =================== MONITORING / UPTIME ===================
// Phase 4 kapsamında eklendi. UptimeRobot benzeri monitoring sistemi.

enum MonitorType {
  HTTP
  HTTPS
  PING
  PORT
  KEYWORD
  JSON
}

enum MonitorStatus {
  UP
  DOWN
  PAUSED
  PENDING
}

model Monitor {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String // "Ana Sayfa", "API Endpoint"
  url    String // https://example.com
  type   MonitorType   @default(HTTPS)
  status MonitorStatus @default(PENDING)

  // Check interval (seconds)
  intervalSec Int @default(60) // 60s, 300s, 600s, 1800s, 3600s

  // Expected response
  expectedStatus Int? // 200
  keywordValue   String? // keyword search in body
  jsonPath       String? // $.status == "ok"

  // Timeout
  timeoutSec Int @default(30)

  // Current state
  lastCheckedAt  DateTime?
  lastResponseMs Int?
  uptimePct30d   Float     @default(100)

  // Public visibility
  isPublic   Boolean @default(false)
  publicSlug String? @unique

  // Notifications
  alertChannelIds Json @default("[]")

  // SSL/TLS info
  sslExpiresAt DateTime?

  // Metadata
  region String @default("eu-west") // eu-west, us-east, asia
  tags   Json   @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checks    MonitorCheck[]
  incidents Incident[]

  @@index([userId])
  @@index([status])
  @@index([isPublic])
  @@index([lastCheckedAt])
}

model MonitorCheck {
  id        String  @id @default(cuid())
  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  timestamp    DateTime @default(now())
  isUp         Boolean
  responseMs   Int?
  statusCode   Int?
  errorMessage String?
  region       String   @default("eu-west")

  @@index([monitorId, timestamp])
  @@index([isUp])
  @@index([timestamp])
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Incident {
  id        String  @id @default(cuid())
  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  startedAt   DateTime  @default(now())
  resolvedAt  DateTime?
  durationSec Int?

  severity IncidentSeverity @default(MEDIUM)
  reason   String // "Connection timeout", "503 Service Unavailable"

  affectedChecks Int @default(0) // Kaç check başarısız oldu
  totalChecks    Int @default(0)

  @@index([monitorId])
  @@index([startedAt])
  @@index([resolvedAt])
}

// =================== ALERT CHANNELS ===================

enum AlertChannelType {
  EMAIL
  WEBHOOK
  SLACK
  DISCORD
  TELEGRAM
}

model AlertChannel {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String // "Production Email", "Slack #ops"
  type   AlertChannelType
  config Json // { email: "..." } veya { webhookUrl: "..." }

  active Boolean @default(true)
  events Json    @default("[]") // ["down", "up", "ssl_expiry"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// =================== STATUS PAGES (PUBLIC) ===================

model StatusPage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug        String  @unique
  title       String
  description String?
  brandColor  String  @default("#0078D4")
  isPublic    Boolean @default(true)

  monitorIds Json @default("[]") // [monitorId1, monitorId2]

  customDomain String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([slug])
}

// =================== USER SUBSCRIPTION (PLAN LINK) ===================
// Customer/Plan yerine User bazlı sadeleştirilmiş abonelik kaydı.

model UserSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planSlug String // "starter", "pro", "enterprise" - hardcoded enum gibi davranır
  status   String @default("active") // active, expired, cancelled, paused

  startedAt DateTime @default(now())
  expiresAt DateTime
  autoRenew Boolean  @default(true)

  stripeSubscriptionId String? @unique

  // Pause/Resume alanlari (Phase Subscription Pause kapsaminda eklendi).
  pausedAt    DateTime?
  pauseEndsAt DateTime?
  pauseReason String?

  // Pause history JSON: [{ pausedAt, resumedAt, reason, durationDays }]
  pauseHistory Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, expiresAt])
}

/// Newsletter Subscriber
/// Blog için email abone sistemi. Double opt-in (verification) ile GDPR uyumu.
model NewsletterSubscriber {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?

  // Preferences
  categories Json    @default("[]") // ["Software Development", "Frontend", ...]
  active     Boolean @default(true)

  // Verification
  verifiedAt  DateTime?
  verifyToken String?   @unique

  // Unsubscribe
  unsubscribedAt   DateTime?
  unsubscribeToken String?   @unique

  source    String? // "blog", "footer", "landing-page"
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([active])
  @@index([verifiedAt])
  @@map("newsletter_subscribers")
}

/// Blog Comment
/// Kullanıcıların blog yazılarına yorum yapmasını sağlar.
/// 1-level nested replies destekler (parentId ile).
model Comment {
  id String @id @default(cuid())

  blogId String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  content String

  // Nested comments (1 level only)
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  // Moderation
  approved Boolean   @default(true)
  flagged  Boolean   @default(false)
  editedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blogId, createdAt])
  @@index([userId])
  @@index([parentId])
}

// =================== WEBHOOKS (USER-DEFINED) ===================
// Kullanıcıların kendi endpoint'lerine gönderdiği webhook'lar.
// HMAC imza, exponential backoff retry, dead letter queue destekli.

model Webhook {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url         String
  description String?
  events      Json    @default("[]")
  secret      String

  active Boolean @default(true)

  totalDeliveries  Int       @default(0)
  failedDeliveries Int       @default(0)
  lastDeliveryAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([userId])
  @@index([active])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
  DEAD_LETTER
}

model WebhookDelivery {
  id        String  @id @default(cuid())
  webhookId String
  webhook   Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  event   String
  payload Json

  status      WebhookDeliveryStatus @default(PENDING)
  attempts    Int                   @default(0)
  maxAttempts Int                   @default(5)

  responseStatus Int?
  responseBody   String? @db.Text
  errorMessage   String?

  nextRetryAt DateTime?

  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([webhookId, status])
  @@index([status, nextRetryAt])
}

// =================== NOTIFICATIONS (IN-APP) ===================
// Phase 8 kapsamında eklendi. Kullanıcıya gerçek zamanlı bildirimler (SSE + polling).

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String  // order.created, order.paid, monitor.down, monitor.up, comment.reply, vb.
  title   String
  message String
  link    String?
  icon    String?

  read   Boolean   @default(false)
  readAt DateTime?

  // Optional related entity
  relatedType String? // "Order" | "Monitor" | "Comment" | "Blog"
  relatedId   String?

  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
}
