generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model About {
  id              String       @id @default(cuid())
  name            String
  title           String
  subTitle        String?
  headerTitle     String
  profileImage    String?
  aboutImage      String?
  content         String
  contactEmail    String?
  socialGithub    String?
  socialLinkedin  String?
  socialInstagram String?
  workingOn       String       @default("")
  experiences     Experience[]
  skills          Skill[]
}

model Experience {
  id          String  @id @default(cuid())
  title       String
  company     String
  date        String
  description String
  aboutId     String?
  about       About?  @relation(fields: [aboutId], references: [id])
}

model Skill {
  id      String  @id @default(cuid())
  name    String
  icon    String?
  aboutId String?
  About   About?  @relation(fields: [aboutId], references: [id])
}

model Testimonial {
  id      String  @id @default(cuid())
  name    String
  title   String
  company String
  avatar  String?
  comment String
}

model Blog {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  date        DateTime @default(now())
  description String
  thumbnail   String?
  author      String
  category    String
  tags        Json     @default("[]")
  content     String

  // Analytics alanlari (Phase 6 blog analytics kapsaminda eklendi).
  viewCount       Int @default(0)
  readTimeMinutes Int @default(1)
  likeCount       Int @default(0)

  // Scheduling & Drafts (Phase Blog Scheduling kapsaminda eklendi).
  status          String    @default("published") // draft | scheduled | published
  publishedAt     DateTime?
  scheduledAt     DateTime?
  draftSavedAt    DateTime?
  version         Int       @default(1)
  parentVersionId String?

  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([viewCount])
  @@index([status, scheduledAt])
}

model Project {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  description  String
  mainImage    String?
  technologies Json      @default("[]")
  liveDemo     String?
  githubRepo   String?
  order        Int       @default(0)
  featured     Boolean   @default(false)
  isLive       Boolean   @default(false)
  content      String
  date         DateTime?
}

model Popup {
  id              String  @id @default(cuid())
  slug            String  @unique
  title           String
  content         String
  imageUrl        String?
  youtubeEmbedUrl String?
  isActive        Boolean @default(true)
  buttons         Json    @default("[]")
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  timestamp DateTime @default(now())
  isRead    Boolean  @default(false)
  replies   Json     @default("[]")
}

model HomeSettings {
  id                  String  @id @default(cuid())
  featuredContentType String
  youtubeUrl          String?
  textTitle           String?
  textContent         String?
  customHtml          String?
}

model SeoSettings {
  id                 String  @id @default(cuid())
  siteTitle          String
  siteDescription    String
  siteKeywords       String  @default("")
  canonicalUrl       String
  robots             String
  favicon            String?
  ogTitle            String?
  ogDescription      String?
  ogImage            String?
  ogType             String?
  ogUrl              String?
  ogSiteName         String?
  twitterCard        String?
  twitterSite        String?
  twitterCreator     String?
  twitterTitle       String?
  twitterDescription String?
  twitterImage       String?
}

/// Admin Audit Log
/// Admin panelinden yapılan tüm kritik işlemleri kayıt altına alır.
/// Phase 2E kapsamında eklendi.
model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  userEmail    String?
  action       String
  resource     String
  resourceId   String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  status       String   @default("success")
  errorMessage String?
  timestamp    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([timestamp])
  @@map("audit_logs")
}

// =================== COMMERCE / SAAS ===================

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  FULFILLED
  CANCELED
}

enum PlanInterval {
  MONTH
  YEAR
  WEEK
  DAY
}

enum LicenseType {
  PERPETUAL
  SUBSCRIPTION
  TRIAL
  ONE_TIME
}

model Plan {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            String
  description     String?
  stripePriceId   String       @unique
  stripeProductId String
  interval        PlanInterval @default(MONTH)
  priceCents      Int
  currency        String       @default("try")
  features        Json         @default("[]")
  active          Boolean      @default(true)
  isFeatured      Boolean      @default(false)
  order           Int          @default(0)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model Customer {
  id               String  @id @default(cuid())
  userId           String? @unique
  user             User?   @relation(fields: [userId], references: [id])
  email            String  @unique
  name             String?
  stripeCustomerId String? @unique
  phone            String?
  billingAddress   Json?

  subscriptions Subscription[]
  orders        Order[]
  licenses      License[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id])

  stripeSubscriptionId String             @unique
  stripeStatus         String
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?

  trialStart DateTime?
  trialEnd   DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model DigitalProduct {
  id               String  @id @default(cuid())
  slug             String  @unique
  title            String
  shortDescription String
  description      String
  thumbnail        String?
  images           Json    @default("[]")
  fileUrl          String
  fileName         String
  fileSize         Int
  priceCents       Int
  currency         String  @default("try")

  // Delivery
  downloadCountMax Int @default(5)
  ttlHours         Int @default(72)

  // Metadata
  technologies Json    @default("[]")
  category     String  @default("general")
  version      String?
  requirements Json?

  active   Boolean @default(true)
  featured Boolean @default(false)
  order    Int     @default(0)

  // Owner (SaaS)
  ownerId String?
  owner   User?   @relation("ProductOwner", fields: [ownerId], references: [id])

  orderItems OrderItem[]
  licenses   License[]
  videoCalls VideoCall[]

  // Marketplace 2.0 — vendor publishing + reviews + Q&A
  vendorId  String?
  vendor    VendorProfile?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  reviews   ProductReview[]
  questions ProductQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
  @@index([category])
  @@index([ownerId])
  @@index([vendorId])
}

model Order {
  id          String    @id @default(cuid())
  orderNumber String    @unique
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])

  // SaaS user link
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Stripe
  stripeSessionId     String  @unique
  stripePaymentIntent String? @unique

  status OrderStatus @default(PENDING)

  // Money
  subtotalCents Int
  taxCents      Int     @default(0)
  totalCents    Int
  currency      String  @default("try")
  exchangeRate  Float? // payment currency -> TRY (1 TRY = X foreign)
  taxRate       Float? // applied tax rate (e.g. 0.20 for %20 VAT)
  taxCountry    String? // ISO country code applied (e.g. "TR", "US", "DE")

  // Customer info snapshot
  customerEmail String
  customerName  String?

  // Fulfillment
  deliveredAt  DateTime?
  refundedAt   DateTime?
  refundReason String?

  // Coupon / Discount
  couponId      String?
  coupon        Coupon? @relation(fields: [couponId], references: [id])
  discountCents Int     @default(0)

  metadata Json?
  notes    String?

  items               OrderItem[]
  licenses            License[]
  videoCalls          VideoCall[]
  affiliateCommission AffiliateCommission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([couponId])
  @@index([userId])
}

// =================== MULTI-CURRENCY & TAX ===================
// Phase "Multi-currency + Tax + A/B" kapsaminda eklendi.
// Desteklenen para birimleri: TRY, USD, EUR, GBP.
// Kur bilgisi ExchangeRate tablosunda cache'lenir (24 saatlik TTL).
// Vergi oranlari TaxRate tablosunda ulke bazli tutulur.

model ExchangeRate {
  id        String   @id @default(cuid())
  fromCurr  String // "USD"
  toCurr    String // "TRY"
  rate      Float // 1 fromCurr = X toCurr
  source    String   @default("manual") // manual | api | fallback
  validAt   DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([fromCurr, toCurr])
  @@index([validAt])
}

model TaxRate {
  id          String  @id @default(cuid())
  country     String  @unique // ISO code: "TR", "US", "DE"
  countryName String
  rate        Float // 0.20 = %20
  type        String  @default("vat") // vat | gst | sales_tax
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Coupon {
  id                 String       @id @default(cuid())
  code               String       @unique
  description        String?
  discountType       DiscountType @default(PERCENTAGE)
  discountValue      Int
  minOrderCents      Int          @default(0)
  maxDiscountCents   Int?
  maxUses            Int?
  currentUses        Int          @default(0)
  maxUsesPerUser     Int          @default(1)
  startsAt           DateTime?
  expiresAt          DateTime?
  applicableProducts Json?
  applicablePlans    Json?
  active             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]

  @@index([code, active])
  @@index([active])
  @@index([expiresAt])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id])
  orderId       String?
  customerEmail String
  discountCents Int
  redeemedAt    DateTime @default(now())

  @@index([couponId])
  @@index([customerEmail])
  @@index([couponId, customerEmail])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   DigitalProduct @relation(fields: [productId], references: [id])

  quantity       Int @default(1)
  unitPriceCents Int
  totalCents     Int

  // Snapshot
  productTitle String
  productSlug  String

  createdAt DateTime @default(now())

  @@index([orderId])
}

model License {
  id         String         @id @default(cuid())
  key        String         @unique
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id])
  productId  String
  product    DigitalProduct @relation(fields: [productId], references: [id])
  orderId    String?
  order      Order?         @relation(fields: [orderId], references: [id])

  // SaaS user link
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  type               LicenseType @default(ONE_TIME)
  status             String      @default("active")
  maxActivations     Int         @default(1)
  currentActivations Int         @default(0)

  expiresAt    DateTime?
  revokedAt    DateTime?
  revokeReason String?

  activations Json  @default("[]")
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([productId])
  @@index([status])
  @@index([userId])
}

model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
  payload       Json
  success       Boolean  @default(true)
  error         String?

  @@index([type])
  @@index([processedAt])
}

// =================== TEAM / WORKSPACE / RBAC ===================
// Phase 3 kapsamında eklendi. Multi-tenant workspace sistemi + rol bazlı erişim kontrolü.

model Workspace {
  id          String                @id @default(cuid())
  slug        String                @unique
  name        String
  description String?
  ownerId     String
  owner       User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  tasks       Task[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([ownerId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User?         @relation(fields: [userId], references: [id])
  userEmail   String
  userName    String?
  role        WorkspaceRole @default(VIEWER)
  joinedAt    DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model WorkspaceInvitation {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        WorkspaceRole    @default(VIEWER)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedBy   String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@index([workspaceId])
  @@index([email, status])
}

// =================== USER / AUTH (NextAuth) ===================
// Phase 4 kapsamında eklendi. Centralized user account for SaaS features.

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String? // bcrypt hash, NextAuth credential provider
  image         String?
  emailVerified DateTime?

  // 2FA (TOTP) alanlari - Phase 5 auth genisletme kapsaminda eklendi.
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes Json?
  twoFactorVerifiedAt  DateTime?

  // Profile + Referral alanlari (Phase Chat + Coupon Advanced kapsaminda eklendi).
  birthDate     DateTime?
  referralCode  String?   @unique
  referredBy    String?
  referralCount Int       @default(0)

  // Video Calls (Phase "Video Calls + Affiliate" kapsaminda eklendi)
  videoCallCredits Int @default(60) // Dakika cinsinden

  // Affiliate / Referral Commission (Phase "Video Calls + Affiliate" kapsaminda eklendi)
  affiliateBalanceCents Int     @default(0)
  affiliatePercent      Float   @default(20.0) // Default %20 komisyon
  affiliateApproved     Boolean @default(false) // Manuel payout onayı

  // Relations
  accounts             Account[]
  sessions             Session[]
  apiKeys              ApiKey[]
  monitors             Monitor[]
  alertChannels        AlertChannel[]
  subscriptions        UserSubscription[]
  statusPages          StatusPage[]
  customerProfile      Customer?
  orders               Order[]
  uploadedProducts     DigitalProduct[]   @relation("ProductOwner")
  bundles              Bundle[]           @relation("BundleOwner")
  licenses             License[]
  workspaceMemberships WorkspaceMember[]
  ownedWorkspaces      Workspace[]        @relation("WorkspaceOwner")
  auditLogs            AuditLog[]
  comments             Comment[]
  webhooks             Webhook[]
  notifications        Notification[]
  conversations        ChatConversation[]

  // Video Call relations
  hostedCalls        VideoCall[]            @relation("VideoCallHost")
  callParticipations VideoCallParticipant[]

  // Affiliate relations
  affiliateReferrals AffiliateCommission[] @relation("AffiliateReferrer")
  affiliateReferred  AffiliateCommission[] @relation("AffiliateReferred")
  affiliatePayouts   AffiliatePayout[]

  // Partner Program relations (Phase "Partner Program" kapsaminda eklendi)
  partner Partner?

  // Task management relations
  createdTasks    Task[]           @relation("TaskCreator")
  taskAssignments TaskAssignee[]
  taskComments    TaskComment[]
  taskAttachments TaskAttachment[]

  // Marketplace 2.0 relations
  vendorProfile    VendorProfile?
  productReviews   ProductReview[]
  productQuestions ProductQuestion[]

  // A/B Testing relations
  abExperimentsCreated ABExperiment[]

  // Email Marketing relations
  emailPreference    EmailPreference?
  campaignExecutions CampaignExecution[]

  // Push Notifications (Web Push)
  pushSubscriptions PushSubscription[]

  // Loyalty relations
  loyaltyAccount LoyaltyAccount?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([referralCode])
}

// =================== LOYALTY PROGRAM ===================
// Kullanicinin puan, tier ve odul islemlerini yonetir.
// Bronze/Silver/Gold/Platinum tier sistemi + redeem odulleri.

model LoyaltyAccount {
  id             String               @id @default(cuid())
  userId         String               @unique
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  points         Int                  @default(0)
  lifetimePoints Int                  @default(0)
  tier           String               @default("bronze")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  transactions   LoyaltyTransaction[]

  @@index([tier])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id        String         @id @default(cuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      String // earn | redeem | bonus | adjustment
  points    Int // Pozitif: kazanilan, Negatif: harcanan
  balance   Int // Islem sonrasi bakiye
  reason    String
  reference String?
  createdAt DateTime       @default(now())

  @@index([accountId, createdAt])
  @@map("loyalty_transactions")
}

model LoyaltyReward {
  id              String   @id @default(cuid())
  name            String
  description     String
  type            String   @default("discount") // discount | freebie | shipping
  pointsCost      Int
  discountPercent Int?
  discountCents   Int?
  active          Boolean  @default(true)
  tier            String   @default("bronze") // Minimum tier required
  stock           Int? // null = sinirsiz
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, tier])
  @@map("loyalty_rewards")
}

/// Email Marketing Campaigns
/// Drip / broadcast / behavioral email campaigns.
/// Phase: Email Marketing Automation
model EmailCampaign {
  id   String @id @default(cuid())
  name String

  // Type
  campaignType String @default("drip") // drip | broadcast | behavioral

  // Targeting
  triggerEvent   String? // "user.created", "cart.abandoned", "subscription.expiring"
  filterAudience Json? // { country: "TR", age: 25-35 }

  // Content
  subject   String
  template  String  @db.Text // HTML
  fromName  String  @default("Noktanyus")
  fromEmail String?

  // Schedule
  status      String    @default("draft") // draft | scheduled | running | completed | paused
  scheduledAt DateTime?

  // Stats
  totalSent    Int @default(0)
  totalOpened  Int @default(0)
  totalClicked Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps      CampaignStep[]
  executions CampaignExecution[]

  @@index([status, scheduledAt])
  @@map("email_campaigns")
}

/// Campaign Step — Drip campaign'lerin sirali adimlari.
/// Order ile siralanir, delayHours ile bir sonraki step'e gecis suresi belirlenir.
model CampaignStep {
  id         String        @id @default(cuid())
  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  order      Int
  subject    String
  template   String @db.Text
  delayHours Int    @default(0) // From previous step or campaign start

  @@index([campaignId, order])
  @@map("campaign_steps")
}

/// Campaign Execution — Hangi kullanici hangi campaign'de ne durumda.
/// Open/click tracking, gonderim zamani gibi istatistikleri tutar.
model CampaignExecution {
  id         String        @id @default(cuid())
  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  stepId String?

  status String @default("pending") // pending | sent | opened | clicked | bounced

  sentAt    DateTime?
  openedAt  DateTime?
  clickedAt DateTime?

  @@index([userId, campaignId])
  @@index([status])
  @@map("campaign_executions")
}

/// Email Preference
/// Kullanicinin email abonelik tercihleri.
/// Marketing, transactional ve newsletter kanallari ayri ayri yonetilir.
/// GDPR uyumu icin unsubscribe tarihi ve sebebi tutulur.
model EmailPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketing     Boolean @default(true)
  transactional Boolean @default(true)
  newsletter    Boolean @default(true)

  unsubscribedAt    DateTime?
  unsubscribeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_preferences")
}

// =================== A/B TESTING ===================
// Phase "Multi-currency + Tax + A/B" kapsaminda eklendi.
// Site genelinde A/B test (bucket experiment) altyapisi.
// Sticky variant atama (sessionId bazli), weighted random, conversion tracking.

model ABExperiment {
  id String @id @default(cuid())

  name        String  @unique
  description String?
  status      String  @default("draft") // draft | running | completed | paused

  // Targeting
  targetPage     String // "/", "/magaza", "/fiyatlandirma"
  audienceFilter Json? // { country, device, ... }

  // Stats
  startedAt       DateTime?
  endedAt         DateTime?
  winnerVariantId String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  variants ABVariant[]
  events   ABEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, targetPage])
}

model ABVariant {
  id           String       @id @default(cuid())
  experimentId String
  experiment   ABExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  name   String // "Control", "Variant A", "Variant B"
  weight Int    @default(50) // %50 - toplam 100 olmali
  config Json   @default("{}") // { headline: "...", ctaColor: "blue" }

  isControl Boolean @default(false)

  events ABEvent[]

  @@index([experimentId])
}

enum ABEventType {
  EXPOSURE // Variant goruntulendi
  CONVERSION // Istenen aksiyon gerceklesti
}

model ABEvent {
  id           String       @id @default(cuid())
  experimentId String
  experiment   ABExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ABVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  userId    String?
  sessionId String
  eventType ABEventType
  value     Float? // conversion value

  metadata Json @default("{}")

  createdAt DateTime @default(now())

  @@index([experimentId, variantId, eventType])
  @@index([sessionId])
}

/// Chat Conversation
/// In-app canli destek sistemi. Kullanici <-> Admin mesajlasma akisi.
/// Phase Chat + Coupon Advanced kapsaminda eklendi.
model ChatConversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject String
  status  String @default("open") // open | waiting | closed

  assignedTo String? // admin user id

  lastMessageAt DateTime?
  unreadByUser  Int       @default(0)
  unreadByAdmin Int       @default(0)

  messages ChatMessage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?

  @@index([userId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([assignedTo, status])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId   String
  senderRole String // "user" | "admin"
  senderName String

  content     String @db.Text
  attachments Json   @default("[]")

  read   Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

// =================== DIGITAL PRODUCT BUNDLES ===================
// Phase "Subscription + Bundles" kapsaminda eklendi.
// Birden fazla dijital urunu paketleyip indirimli satma imkani saglar.

model Bundle {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  description      String
  shortDescription String
  thumbnail        String?

  // Pricing
  priceCents         Int // Bundle discounted price
  originalPriceCents Int // Sum of individual product prices
  currency           String @default("try")

  // Products (JSON array of product ids)
  productIds Json @default("[]")

  // Metadata
  features Json    @default("[]")
  category String  @default("bundle")
  version  String?

  // Status
  active   Boolean @default(true)
  featured Boolean @default(false)
  order    Int     @default(0)

  // Sales counter
  totalSales Int @default(0)

  // Owner (SaaS)
  ownerId String?
  owner   User?   @relation("BundleOwner", fields: [ownerId], references: [id])

  purchases BundlePurchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
  @@index([ownerId])
}

model BundlePurchase {
  id       String @id @default(cuid())
  bundleId String
  bundle   Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  buyerEmail String
  buyerId    String?

  priceCents Int
  currency   String

  status String @default("completed") // completed | refunded

  createdAt DateTime @default(now())

  @@index([bundleId])
  @@index([buyerId])
}

// NextAuth OAuth (opsiyonel - ileride Google/GitHub login için)
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

// =================== API KEYS / RATE LIMITING ===================
// Phase 4 kapsamında eklendi. Public API için API key yönetimi + rate limit.

model ApiKey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String // "Production Server", "Mobile App" vb.
  key    String @unique // nokt_live_xxxxx veya nokt_test_xxxxx
  prefix String // İlk 8 karakter (UI'da gösterim için)
  scopes Json   @default("[]") // ["read:monitor", "write:monitor", "admin"]

  // Limits
  rateLimit    Int  @default(60) // requests per minute
  monthlyQuota Int? // null = unlimited

  // Tracking
  lastUsedAt    DateTime?
  totalRequests Int       @default(0)

  // Lifecycle
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages ApiKeyUsage[]

  @@index([userId])
  @@index([key])
}

model ApiKeyUsage {
  id       String @id @default(cuid())
  apiKeyId String
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  endpoint   String // "/api/monitor/check"
  method     String // "GET", "POST"
  statusCode Int // 200, 401, 429
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([apiKeyId, timestamp])
  @@index([endpoint])
}

// =================== MONITORING / UPTIME ===================
// Phase 4 kapsamında eklendi. UptimeRobot benzeri monitoring sistemi.

enum MonitorType {
  HTTP
  HTTPS
  PING
  PORT
  KEYWORD
  JSON
}

enum MonitorStatus {
  UP
  DOWN
  PAUSED
  PENDING
}

model Monitor {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String // "Ana Sayfa", "API Endpoint"
  url    String // https://example.com
  type   MonitorType   @default(HTTPS)
  status MonitorStatus @default(PENDING)

  // Check interval (seconds)
  intervalSec Int @default(60) // 60s, 300s, 600s, 1800s, 3600s

  // Expected response
  expectedStatus Int? // 200
  keywordValue   String? // keyword search in body
  jsonPath       String? // $.status == "ok"

  // Timeout
  timeoutSec Int @default(30)

  // Current state
  lastCheckedAt  DateTime?
  lastResponseMs Int?
  uptimePct30d   Float     @default(100)

  // Public visibility
  isPublic   Boolean @default(false)
  publicSlug String? @unique

  // Notifications
  alertChannelIds Json @default("[]")

  // SSL/TLS info
  sslExpiresAt DateTime?

  // Metadata
  region String @default("eu-west") // eu-west, us-east, asia
  tags   Json   @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checks    MonitorCheck[]
  incidents Incident[]

  @@index([userId])
  @@index([status])
  @@index([isPublic])
  @@index([lastCheckedAt])
}

model MonitorCheck {
  id        String  @id @default(cuid())
  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  timestamp    DateTime @default(now())
  isUp         Boolean
  responseMs   Int?
  statusCode   Int?
  errorMessage String?
  region       String   @default("eu-west")

  @@index([monitorId, timestamp])
  @@index([isUp])
  @@index([timestamp])
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Incident {
  id        String  @id @default(cuid())
  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  startedAt   DateTime  @default(now())
  resolvedAt  DateTime?
  durationSec Int?

  severity IncidentSeverity @default(MEDIUM)
  reason   String // "Connection timeout", "503 Service Unavailable"

  affectedChecks Int @default(0) // Kaç check başarısız oldu
  totalChecks    Int @default(0)

  @@index([monitorId])
  @@index([startedAt])
  @@index([resolvedAt])
}

// =================== ALERT CHANNELS ===================

enum AlertChannelType {
  EMAIL
  WEBHOOK
  SLACK
  DISCORD
  TELEGRAM
}

model AlertChannel {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String // "Production Email", "Slack #ops"
  type   AlertChannelType
  config Json // { email: "..." } veya { webhookUrl: "..." }

  active Boolean @default(true)
  events Json    @default("[]") // ["down", "up", "ssl_expiry"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// =================== STATUS PAGES (PUBLIC) ===================

model StatusPage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug        String  @unique
  title       String
  description String?
  brandColor  String  @default("#0078D4")
  isPublic    Boolean @default(true)

  monitorIds Json @default("[]") // [monitorId1, monitorId2]

  customDomain String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([slug])
}

// =================== USER SUBSCRIPTION (PLAN LINK) ===================
// Customer/Plan yerine User bazlı sadeleştirilmiş abonelik kaydı.

model UserSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planSlug String // "starter", "pro", "enterprise" - hardcoded enum gibi davranır
  status   String @default("active") // active, expired, cancelled, paused

  startedAt DateTime @default(now())
  expiresAt DateTime
  autoRenew Boolean  @default(true)

  stripeSubscriptionId String? @unique

  // Pause/Resume alanlari (Phase Subscription Pause kapsaminda eklendi).
  pausedAt    DateTime?
  pauseEndsAt DateTime?
  pauseReason String?

  // Pause history JSON: [{ pausedAt, resumedAt, reason, durationDays }]
  pauseHistory Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, expiresAt])
}

/// Newsletter Subscriber
/// Blog için email abone sistemi. Double opt-in (verification) ile GDPR uyumu.
model NewsletterSubscriber {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?

  // Preferences
  categories Json    @default("[]") // ["Software Development", "Frontend", ...]
  active     Boolean @default(true)

  // Verification
  verifiedAt  DateTime?
  verifyToken String?   @unique

  // Unsubscribe
  unsubscribedAt   DateTime?
  unsubscribeToken String?   @unique

  source    String? // "blog", "footer", "landing-page"
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([active])
  @@index([verifiedAt])
  @@map("newsletter_subscribers")
}

/// Blog Comment
/// Kullanıcıların blog yazılarına yorum yapmasını sağlar.
/// 1-level nested replies destekler (parentId ile).
model Comment {
  id String @id @default(cuid())

  blogId String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  content String

  // Nested comments (1 level only)
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  // Moderation
  approved Boolean   @default(true)
  flagged  Boolean   @default(false)
  editedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blogId, createdAt])
  @@index([userId])
  @@index([parentId])
}

// =================== WEBHOOKS (USER-DEFINED) ===================
// Kullanıcıların kendi endpoint'lerine gönderdiği webhook'lar.
// HMAC imza, exponential backoff retry, dead letter queue destekli.

model Webhook {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url         String
  description String?
  events      Json    @default("[]")
  secret      String

  active Boolean @default(true)

  totalDeliveries  Int       @default(0)
  failedDeliveries Int       @default(0)
  lastDeliveryAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([userId])
  @@index([active])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
  DEAD_LETTER
}

model WebhookDelivery {
  id        String  @id @default(cuid())
  webhookId String
  webhook   Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  event   String
  payload Json

  status      WebhookDeliveryStatus @default(PENDING)
  attempts    Int                   @default(0)
  maxAttempts Int                   @default(5)

  responseStatus Int?
  responseBody   String? @db.Text
  errorMessage   String?

  nextRetryAt DateTime?

  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([webhookId, status])
  @@index([status, nextRetryAt])
}

// =================== NOTIFICATIONS (IN-APP) ===================
// Phase 8 kapsamında eklendi. Kullanıcıya gerçek zamanlı bildirimler (SSE + polling).

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String // order.created, order.paid, monitor.down, monitor.up, comment.reply, vb.
  title   String
  message String
  link    String?
  icon    String?

  read   Boolean   @default(false)
  readAt DateTime?

  // Optional related entity
  relatedType String? // "Order" | "Monitor" | "Comment" | "Blog"
  relatedId   String?

  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
}

// =================== MARKETPLACE 2.0 (VENDORS + REVIEWS + Q&A) ===================
// Marketplace 2.0 kapsamında eklendi. Kullanıcıların kendi SaaS ürünlerini
// yayınlayabildiği, satıcı (vendor) profili, yorum/puan sistemi ve Q&A altyapısı.

model VendorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String
  slug        String  @unique
  bio         String? @db.Text
  avatar      String?
  banner      String?
  website     String?
  twitter     String?
  github      String?

  // Stats
  totalProducts Int   @default(0)
  totalSales    Int   @default(0)
  avgRating     Float @default(0)
  responseTime  Int? // hours

  // Status
  verified Boolean @default(false)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products DigitalProduct[]
  reviews  ProductReview[]

  @@index([slug])
  @@index([active, verified])
  @@index([avgRating])
}

model ProductReview {
  id        String         @id @default(cuid())
  productId String
  product   DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  reviewerId String
  reviewer   User          @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  vendorId   String
  vendor     VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  rating  Int // 1-5
  comment String? @db.Text

  approved Boolean @default(true)
  flagged  Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([productId, reviewerId])
  @@index([productId, approved])
  @@index([vendorId])
  @@index([rating])
}

model ProductQuestion {
  id        String         @id @default(cuid())
  productId String
  product   DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  askerId String
  asker   User   @relation(fields: [askerId], references: [id], onDelete: Cascade)

  question   String    @db.Text
  answer     String?   @db.Text
  answeredAt DateTime?
  answeredBy String? // vendor userId

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([askerId])
}

// =================== TEAM / TASK MANAGEMENT ===================
// Phase: Workspace Team + Task Management
// Workspace üyeleri task oluşturabilir, atayabilir, takip edebilir.

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  status      String  @default("todo") // todo | in_progress | review | done | cancelled
  priority    String  @default("medium") // low | medium | high | urgent

  // Assignees (many-to-many)
  assignees TaskAssignee[]

  // Time tracking
  estimatedHours Float?
  spentHours     Float?

  // Dates
  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  // Hierarchy
  parentTaskId String?
  parentTask   Task?   @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks     Task[]  @relation("Subtasks")

  // Metadata
  tags Json @default("[]")

  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([workspaceId, status])
  @@index([workspaceId, dueDate])
  @@index([createdById])
  @@index([parentTaskId])
}

model TaskAssignee {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskComment {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  content  String @db.Text

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

model TaskAttachment {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  fileName String
  fileUrl  String
  fileSize Int
  mimeType String

  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id])
  uploadedAt DateTime @default(now())

  @@index([taskId])
}

// =================== VIDEO CALLS (WebRTC STUB) ===================
// Phase "Video Calls + Affiliate" kapsaminda eklendi.
// Host tabanlı meeting room. Gerçek peer connection için signaling server
// gerekir; burada odaları/katılımcıları DB'de tutuyoruz, UI getUserMedia stub'i
// ile çalışır.

model VideoCall {
  id     String @id @default(cuid())
  hostId String
  host   User   @relation("VideoCallHost", fields: [hostId], references: [id], onDelete: Cascade)

  title       String
  description String?

  // Meeting config
  scheduledAt      DateTime?
  durationMin      Int       @default(60)
  maxParticipants  Int       @default(10)
  recordingEnabled Boolean   @default(false)

  // Status
  status String @default("scheduled") // scheduled | active | ended | cancelled

  // Meeting room
  roomCode String @unique

  // Participants
  participants VideoCallParticipant[]

  // Recording
  recordingUrl         String?
  recordingDurationSec Int?

  // Relations
  productId String?
  product   DigitalProduct? @relation(fields: [productId], references: [id])
  orderId   String?
  order     Order?          @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hostId, status])
  @@index([scheduledAt])
}

model VideoCallParticipant {
  id     String    @id @default(cuid())
  callId String
  call   VideoCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  guestName  String?
  guestEmail String?

  joinedAt    DateTime?
  leftAt      DateTime?
  durationSec Int?

  @@index([callId])
}

// =================== AFFILIATE / REFERRAL COMMISSION ===================
// Phase "Video Calls + Affiliate" kapsaminda eklendi.
// Davet edilen kullanici siparis verdiginde, davet eden affiliate kazanci alir.
// Komisyon pending -> approved -> paid lifecycle ile yonetilir.

model AffiliateCommission {
  id String @id @default(cuid())

  referrerId String
  referrer   User   @relation("AffiliateReferrer", fields: [referrerId], references: [id])

  referredId String
  referred   User   @relation("AffiliateReferred", fields: [referredId], references: [id])

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  // Commission
  orderAmountCents  Int
  commissionPercent Float
  commissionCents   Int

  // Status
  status     String    @default("pending") // pending | approved | paid | cancelled
  approvedAt DateTime?
  paidAt     DateTime?
  payoutId   String?

  payout AffiliatePayout? @relation(fields: [payoutId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId, status])
  @@index([referredId])
}

model AffiliatePayout {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amountCents Int
  method      String // bank_transfer | paypal | stripe
  reference   String? // transaction ID
  notes       String?

  status String @default("pending") // pending | processing | completed | failed

  commissions AffiliateCommission[]

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// =================== PARTNER PROGRAM (B2B RESELLERS) ===================
// Phase "Partner Program" kapsaminda eklendi.
// Is ortaklari (firmalar) kendi landing page'leri uzerinden lead toplar,
// lead'in conversion'i halinde komisyon kazanir. Affiliate'dan farki: B2B
// firma bazli, slug ile public landing page, webhook notification.

model Partner {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName  String
  slug         String  @unique
  contactEmail String
  website      String?
  description  String?

  // Status
  verified Boolean @default(false)
  active   Boolean @default(true)

  // Commission
  commissionPercent Float @default(15.0)

  // Stats (denormalized)
  totalLeads       Int @default(0)
  totalConversions Int @default(0)

  // Webhook integration (partner kendi sistemine bildirim almak isterse)
  webhookUrl    String?
  webhookSecret String?

  leads PartnerLead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug, active])
  @@index([active, verified])
  @@map("partners")
}

/// Partner Lead — partner landing page'den gelen potansiyel musteri.
/// Status lifecycle: pending -> qualified -> converted | rejected
model PartnerLead {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  customerEmail String
  customerName  String?

  source   String @default("api") // api | landing_page | manual
  metadata Json   @default("{}")

  // Status: pending | qualified | converted | rejected
  status String @default("pending")

  // Conversion attribution
  orderId          String? @unique
  orderAmountCents Int?
  commissionCents  Int?

  createdAt   DateTime  @default(now())
  convertedAt DateTime?

  @@index([partnerId, status])
  @@index([customerEmail])
  @@index([createdAt])
  @@map("partner_leads")
}

// =================== PUSH NOTIFICATIONS (WEB PUSH) ===================
// Kullanici tarayicilarina Web Push ile bildirim gondermek icin
// push subscription'lari DB'de saklanir. web-push SDK ile birlikte calisir.

model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  active Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([userId, active])
  @@map("push_subscriptions")
}
